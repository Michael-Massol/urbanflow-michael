# Server-only transport configuration.
TRANSPORT_PROVIDER=demo
TISSEO_API_KEY=
TISSEO_GTFS_PATH=

# Public MapLibre style URL. Leave empty to disable the optional map.
NEXT_PUBLIC_MAP_STYLE_URL=

# Supabase public values are safe for the browser; authorization relies on RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=

# Server-only privileged key. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
